{
    "name": "bloa/website",
    "description": "Official BLOA Programming Language Website",
    "type": "project",
    "require": {
        "php": "^8.1",
        "composer/composer": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Bloa\\Website\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs src/",
        "lint:fix": "phpcbf src/",
        "analyze": "phpstan analyze src/",
        "dev": "php -S localhost:8000 -t .",
        "prod:build": "echo 'Building production assets...'"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "BLOA Community",
            "email": "hello@bloa.dev",
            "role": "developer"
        }
    ],
    "keywords": [
        "bloa",
        "programming-language",
        "website",
        "modern",
        "elegant"
    ]
}
